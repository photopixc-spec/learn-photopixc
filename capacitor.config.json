{
  "appId": "com.photopixc.learn",
  "appName": "PhotoPixC Learn",
  "webDir": "www",
  "backgroundColor": "#0f172a",
  "server": {
    "androidScheme": "https",
    "html5mode": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0e7c6b"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notification",
      "iconColor": "#0e7c6b"
    }
  }
}

